     fhir:div [ fhir:v "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Generated Narrative: ImplementationGuide kl.dk.fhir.ltt</b></p><a name=\"kl.dk.fhir.ltt\"> </a><a name=\"hckl.dk.fhir.ltt\"> </a><h2>LTT</h2><p>The official URL for this implementation guide is: </p><pre>http://fhir.kl.dk/ltt/ImplementationGuide/kl.dk.fhir.ltt</pre><div><p>LTT provides the specification for reporting selected data on the use of easily accessible services (lettilgængelige tilbud) offered by municipalities for children and youth experiencing mental distress (SUL §126a). Data is reported to FK Gateway</p>\n</div></div>"^^rdf:XMLLiteral ]
