                <td>
                  <div>
                    <p>Mental sundhed</p>

                  </div>
                </td>
                <td>
                  <span class="copy-text-inline">
                    <button data-clipboard-text="{&quot;system&quot;: &quot;urn:oid:1.2.208.176.2.21&quot;, &quot;version&quot;: &quot;2.4.0&quot;, &quot;code&quot;: &quot;3547a306-8623-4713-a8ce-db1e82839c50&quot;, &quot;display&quot;: &quot;Mental sundhed&quot;}" title="Click to Copy as Coding" class="btn-copy"> </button>
