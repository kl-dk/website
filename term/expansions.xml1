                    <button data-clipboard-text="{&quot;system&quot;: &quot;urn:oid:1.2.208.176.2.21&quot;, &quot;version&quot;: &quot;2.4.0&quot;, &quot;code&quot;: &quot;ae911e37-1ed5-4c30-9622-c73640f1c606&quot;, &quot;display&quot;: &quot;Problemer med vandladning&quot;}" title="Click to Copy as Coding" class="btn-copy"> </button>
