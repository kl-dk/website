                    <button data-clipboard-text="&lt;coding&gt;&lt;system value=&quot;urn:oid:1.2.208.176.2.21&quot;&gt;&lt;version value=&quot;2.4.0&quot;&gt;&lt;code value=&quot;B2&quot;&gt;&lt;display value=&quot;1&quot;&gt;&lt;/coding&gt;" title="Click to Copy as Coding" class="btn-copy"> </button>
                  </span>
                </td>
              </tr>
            </table>
          </div>
