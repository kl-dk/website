                  </span>
                </td>
              </tr>
              <tr>
                <td>
                  <a name="x-urn:oid:1.2.208.176.2.21-651a82a3-ff4b-44c1-89dd-574363b33e02"> </a>
                  <code>urn:oid:1.2.208.176.2.21</code>
                </td>
                <td style="white-space:nowrap">  
                  <a href="CodeSystem-FSIII.html#FSIII-651a82a3-ff4b-44c1-89dd-574363b33e02">651a82a3-ff4b-44c1-89dd-574363b33e02</a>
                </td>
                <td>Problemer med daglige aktiviteter</td>
                <td>
                  <div>
