                <td>
                  <span class="copy-text-inline">
                    <button data-clipboard-text="&lt;coding&gt;&lt;system value=&quot;urn:oid:1.2.208.176.2.22&quot;&gt;&lt;version value=&quot;2.4.0&quot;&gt;&lt;code value=&quot;4977ce08-df4d-4c09-8e03-c2a563862e68&quot;&gt;&lt;display value=&quot;Gå og bevæge sig&quot;&gt;&lt;/coding&gt;" title="Click to Copy as Coding" class="btn-copy"> </button>
