                <td>
                  <span class="copy-text-inline">
                    <button data-clipboard-text="{&quot;system&quot;: &quot;urn:oid:1.2.208.176.2.21&quot;, &quot;version&quot;: &quot;2.4.0&quot;, &quot;code&quot;: &quot;I11.3&quot;, &quot;display&quot;: &quot;Problemer med sygdomsindsigt&quot;}" title="Click to Copy as Coding" class="btn-copy"> </button>
