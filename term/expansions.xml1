                </td>
                <td>Problemer med seksualitet</td>
                <td>
                  <div>
                    <p>Brug for støtte til seksuel aktivitet.</p>

                  </div>
                </td>
                <td>
                  <span class="copy-text-inline">
                    <button data-clipboard-text="{&quot;system&quot;: &quot;urn:oid:1.2.208.176.2.21&quot;, &quot;version&quot;: &quot;2.4.0&quot;, &quot;code&quot;: &quot;d5966884-4e41-40c1-b711-6c6cde778360&quot;, &quot;display&quot;: &quot;Problemer med seksualitet&quot;}" title="Click to Copy as Coding" class="btn-copy"> </button>
