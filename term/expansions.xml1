                  <a name="x-urn:oid:1.2.208.176.2.21-7fc48908-33a5-42bf-9d30-feb346e3af21"> </a>
                  <code>urn:oid:1.2.208.176.2.21</code>
                </td>
                <td style="white-space:nowrap">  
                  <a href="CodeSystem-FSIII.html#FSIII-7fc48908-33a5-42bf-9d30-feb346e3af21">7fc48908-33a5-42bf-9d30-feb346e3af21</a>
                </td>
                <td>Problemer med kirurgisk sår</td>
                <td>
                  <div>
                    <p>Brug for støtte til behandling af kirurgisk sår.</p>

                  </div>
                </td>
                <td>
                  <span class="copy-text-inline">
                    <button data-clipboard-text="{&quot;system&quot;: &quot;urn:oid:1.2.208.176.2.21&quot;, &quot;version&quot;: &quot;2.4.0&quot;, &quot;code&quot;: &quot;7fc48908-33a5-42bf-9d30-feb346e3af21&quot;, &quot;display&quot;: &quot;Problemer med kirurgisk sår&quot;}" title="Click to Copy as Coding" class="btn-copy"> </button>
                  </span>
                </td>
                <td>
                  <span class="copy-text-inline">
                    <button data-clipboard-text="&lt;coding&gt;&lt;system value=&quot;urn:oid:1.2.208.176.2.21&quot;&gt;&lt;version value=&quot;2.4.0&quot;&gt;&lt;code value=&quot;7fc48908-33a5-42bf-9d30-feb346e3af21&quot;&gt;&lt;display value=&quot;Problemer med kirurgisk sår&quot;&gt;&lt;/coding&gt;" title="Click to Copy as Coding" class="btn-copy"> </button>
                  </span>
                </td>
              </tr>
              <tr>
                <td>
                  <a name="x-urn:oid:1.2.208.176.2.21-1ee0cce8-b082-464a-a19c-808e7cb082eb"> </a>
                  <code>urn:oid:1.2.208.176.2.21</code>
                </td>
                <td style="white-space:nowrap">  
                  <a href="CodeSystem-FSIII.html#FSIII-1ee0cce8-b082-464a-a19c-808e7cb082eb">1ee0cce8-b082-464a-a19c-808e7cb082eb</a>
                </td>
                <td>Problemer med hud og slimhinder</td>
                <td>
                  <div>
                    <p>Vælges ved problemer med hud og slimhinder, som ikke er sår.</p>

                    <p>Eksempler:  Kløe, kradsemærker, udslæt, skællende hud, eksem eller andre fund i hudens/slimhindernes farve og struktur.</p>

                  </div>
                </td>
                <td>
                  <span class="copy-text-inline">
                    <button data-clipboard-text="{&quot;system&quot;: &quot;urn:oid:1.2.208.176.2.21&quot;, &quot;version&quot;: &quot;2.4.0&quot;, &quot;code&quot;: &quot;1ee0cce8-b082-464a-a19c-808e7cb082eb&quot;, &quot;display&quot;: &quot;Problemer med hud og slimhinder&quot;}" title="Click to Copy as Coding" class="btn-copy"> </button>
                  </span>
                </td>
