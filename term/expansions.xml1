                  <span class="copy-text-inline">
                    <button data-clipboard-text="&lt;coding&gt;&lt;system value=&quot;urn:oid:1.2.208.176.2.21&quot;&gt;&lt;version value=&quot;2.4.0&quot;&gt;&lt;code value=&quot;9c413b5d-9ddb-4298-8f78-f9459c6f142c&quot;&gt;&lt;display value=&quot;Ordination af medicin&quot;&gt;&lt;/coding&gt;" title="Click to Copy as Coding" class="btn-copy"> </button>
                  </span>
                </td>
              </tr>
              <tr>
                <td>
