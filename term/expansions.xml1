                  </span>
                </td>
              </tr>
              <tr>
                <td>
                  <a name="x-urn:oid:1.2.208.176.2.21-c0624874-bdd4-4879-99c5-3a7330f83cc9"> </a>
                  <code>urn:oid:1.2.208.176.2.21</code>
                </td>
                <td style="white-space:nowrap">  
                  <a href="CodeSystem-FSIII.html#FSIII-c0624874-bdd4-4879-99c5-3a7330f83cc9">c0624874-bdd4-4879-99c5-3a7330f83cc9</a>
                </td>
                <td>Fødeindtagelse</td>
                <td>
                  <div>
                    <p>Suge, tygge, bide og behandle maden i mundhulen, synkefunktion, fejlsynkning</p>

                  </div>
                </td>
                <td>
                  <span class="copy-text-inline">
                    <button data-clipboard-text="{&quot;system&quot;: &quot;urn:oid:1.2.208.176.2.21&quot;, &quot;version&quot;: &quot;2.4.0&quot;, &quot;code&quot;: &quot;c0624874-bdd4-4879-99c5-3a7330f83cc9&quot;, &quot;display&quot;: &quot;Fødeindtagelse&quot;}" title="Click to Copy as Coding" class="btn-copy"> </button>
                  </span>
                </td>
                <td>
                  <span class="copy-text-inline">
