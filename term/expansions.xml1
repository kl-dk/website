                  <span class="copy-text-inline">
                    <button data-clipboard-text="&lt;coding&gt;&lt;system value=&quot;urn:oid:1.2.208.176.2.21&quot;&gt;&lt;version value=&quot;2.4.0&quot;&gt;&lt;code value=&quot;cffd4ef7-0282-4a68-a542-bae128172047&quot;&gt;&lt;display value=&quot;Gå på toilet&quot;&gt;&lt;/coding&gt;" title="Click to Copy as Coding" class="btn-copy"> </button>
                  </span>
                </td>
              </tr>
              <tr>
                <td>
