                  </span>
                </td>
              </tr>
              <tr>
                <td>
                  <a name="x-urn:oid:1.2.208.176.2.21-I12.1"> </a>
                  <code>urn:oid:1.2.208.176.2.21</code>
                </td>
                <td style="white-space:nowrap">  
                  <a href="CodeSystem-FSIII.html#FSIII-I12.461">I12.1</a>
                </td>
                <td>Problemer med afføringsinkontinens</td>
                <td>
                  <div>
                    <p>Brug for støtte til at håndtere afføringsproblemer/styre afføring.</p>

                  </div>
                </td>
                <td>
                  <span class="copy-text-inline">
                    <button data-clipboard-text="{&quot;system&quot;: &quot;urn:oid:1.2.208.176.2.21&quot;, &quot;version&quot;: &quot;2.4.0&quot;, &quot;code&quot;: &quot;I12.1&quot;, &quot;display&quot;: &quot;Problemer med afføringsinkontinens&quot;}" title="Click to Copy as Coding" class="btn-copy"> </button>
