                </td>
                <td>Cirkulation</td>
                <td>
                  <div>
                    <p>Kredsløbsforandringer, puls, hjerterytme, blodtryk</p>

                  </div>
                </td>
                <td>
                  <span class="copy-text-inline">
                    <button data-clipboard-text="{&quot;system&quot;: &quot;urn:oid:1.2.208.176.2.21&quot;, &quot;version&quot;: &quot;2.4.0&quot;, &quot;code&quot;: &quot;a2253dcc-4806-4491-af3a-373344a70ccc&quot;, &quot;display&quot;: &quot;Cirkulation&quot;}" title="Click to Copy as Coding" class="btn-copy"> </button>
