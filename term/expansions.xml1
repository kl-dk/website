                    <button data-clipboard-text="{&quot;system&quot;: &quot;urn:oid:1.2.208.176.2.21&quot;, &quot;version&quot;: &quot;2.4.0&quot;, &quot;code&quot;: &quot;880cdd75-c63a-44a0-a4e4-8209644c8628&quot;, &quot;display&quot;: &quot;Kontinens&quot;}" title="Click to Copy as Coding" class="btn-copy"> </button>
