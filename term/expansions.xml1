                </td>
                <td>Emotionelle problemer</td>
                <td>
                  <div>
                    <p>Brug for støtte til at håndtere følelser.</p>

                  </div>
                </td>
                <td>
                  <span class="copy-text-inline">
                    <button data-clipboard-text="{&quot;system&quot;: &quot;urn:oid:1.2.208.176.2.21&quot;, &quot;version&quot;: &quot;2.4.0&quot;, &quot;code&quot;: &quot;7b6a52c6-7e0d-4800-a223-ebdd2c9261e4&quot;, &quot;display&quot;: &quot;Emotionelle problemer&quot;}" title="Click to Copy as Coding" class="btn-copy"> </button>
