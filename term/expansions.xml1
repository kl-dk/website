                  <span class="copy-text-inline">
                    <button data-clipboard-text="&lt;coding&gt;&lt;system value=&quot;urn:oid:1.2.208.176.2.21&quot;&gt;&lt;version value=&quot;2.4.0&quot;&gt;&lt;code value=&quot;074078e1-b78b-4167-b125-f7b76923469e&quot;&gt;&lt;display value=&quot;Praktiske indsatser i relation til børn i husstanden&quot;&gt;&lt;/coding&gt;" title="Click to Copy as Coding" class="btn-copy"> </button>
