                </td>
                <td>Smerter</td>
                <td>
                  <div>
                    <p>Smertelokalitet, smertetype, smertemønster, smertekarakteriska, smerteintensitet, smerte fra dermatom, segmentær smerte</p>

                  </div>
                </td>
                <td>
                  <span class="copy-text-inline">
                    <button data-clipboard-text="{&quot;system&quot;: &quot;urn:oid:1.2.208.176.2.21&quot;, &quot;version&quot;: &quot;2.4.0&quot;, &quot;code&quot;: &quot;40cbf3ef-9ec0-4795-bb3b-ea7c788b49e2&quot;, &quot;display&quot;: &quot;Smerter&quot;}" title="Click to Copy as Coding" class="btn-copy"> </button>
