                  <span class="copy-text-inline">
                    <button data-clipboard-text="{&quot;system&quot;: &quot;urn:oid:1.2.208.176.2.21&quot;, &quot;version&quot;: &quot;2.4.0&quot;, &quot;code&quot;: &quot;d377b371-64f5-416c-93f3-852e437ae1cb&quot;, &quot;display&quot;: &quot;Følelsesfunktioner&quot;}" title="Click to Copy as Coding" class="btn-copy"> </button>
